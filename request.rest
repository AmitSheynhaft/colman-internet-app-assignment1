########################################
# PUT API - UPDATE POST
########################################

PUT http://localhost:3000/api/posts/679272e5f4a6e8b001234567
Content-Type: application/json

### Update a Post
# Method: PUT
# URL: /api/posts/:id
# Content-Type: application/json
# Description: Updates a post with new data, replacing its current content
# Note: You can update any combination of fields (title, content, sender) - not all are required
# 
# Request Body Format:
# {
#   "title": string (optional, 3-200 characters)
#   "content": string (optional, minimum 10 characters)
#   "sender": {
#     "id": number (optional)
#     "name": string (optional)
#   }
# }
# 
# Expected Response: 200 OK
# Response Format:
# {
#   "success": true,
#   "message": "Post updated successfully",
#   "data": {
#     "_id": "string",
#     "title": "string",
#     "content": "string",
#     "sender": {
#       "id": number,
#       "name": "string"
#     },
#     "createdAt": "ISO date string",
#     "updatedAt": "ISO date string"
#   }
# }
# 
# Expected Response (Not Found): 404 Not Found
# Response Format:
# {
#   "success": false,
#   "message": "Post not found"
# }

{
  "title": "Updated Post Title",
  "content": "This is the updated content of the post. It has been modified with new information.",
  "sender": {
    "id": 123,
    "name": "John Doe"
  }
}

