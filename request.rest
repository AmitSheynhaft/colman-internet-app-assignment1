GET http://localhost:3000/api/posts

########################################
# POST API - CREATE NEW POST
########################################

### Create a New Post - Valid Request
# Method: POST
# URL: /api/posts
# Content-Type: application/json
# Description: Creates a new post in the database with title, content, and sender
# 
# Request Body Format:
# {
#   "title": string (required, 3-200 characters)
#   "content": string (required, minimum 10 characters)
#   "sender": {
#     "id": number (required)
#     "name": string (required, not empty)
#   }
# }
# 
# Expected Response: 200 Created
# Response Format:
# {
#   "success": true,
#   "message": "Post created successfully",
#   "data": {
#     "_id": "string",
#     "title": "string",
#     "content": "string",
#     "sender": {
#       "id": number,
#       "name": "string"
#     },
#     "createdAt": "ISO date string",
#     "updatedAt": "ISO date string"
#   }
# }

POST http://localhost:3000/api/posts
Content-Type: application/json

{
  "title": "My First Post",
  "content": "This is the content of my first post. It needs to be at least 10 characters long.",
  "sender": {
    "id": 123,
    "name": "John Doe"
  }
}
